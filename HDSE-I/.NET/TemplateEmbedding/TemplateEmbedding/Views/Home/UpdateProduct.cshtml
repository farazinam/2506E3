@model TemplateEmbedding.Models.Product

<div class="row mt-5">
	<div class="col-lg-6">
		<div class="card card-default">
			<div class="card-header card-header-border-bottom">
				<h2>Product</h2>
			</div>

			<div class="card-body">
				<form asp-controller="Home" asp-action="UpdateProduct" method="post" enctype="multipart/form-data">
					<div class="form-row">
						<div class="col-md-12 mb-3">
							<input type="hidden" asp-for="ProductId" />
							<label for="validationServer01">Product Name</label>
							<input type="text" class="form-control" id="validationServer01" asp-for="ProductName" placeholder="Product Name">

							<label for="validationServer01">Product Price</label>
							<input type="text" class="form-control" id="validationServer01" asp-for="ProductPrice" placeholder="Product Price">

							<label for="validationServer01">Product Description</label>
							<input type="text" class="form-control" id="validationServer01" asp-for="ProductDescription" placeholder="Product Desciption">

							<label for="validationServer01">Product Image</label>
							<input type="hidden" name="oldimg" asp-for="ProductImage" />
							<input type="file" name="f" class="form-control" id="validationServer01" asp-for="ProductImage" placeholder="Product Image">
							@* <span asp-validation-for="ProductImage" class="text-danger"></span> *@

							<label for="validationServer01">Category Name</label>
							<select class="form-select" aria-label="Default select example"
							asp-for="CatId" asp-items="ViewBag.Cats"
							>
								<option disabled selected>Select Category</option>
							</select>
						</div>

					</div>

					<button class="btn btn-primary" type="submit">Update Product</button>
				</form>
			</div>
		</div>
	</div>	

</div>