@model List<Cart>

@{
    ViewBag.Title = "Your Cart";
    decimal? totalAmount = 0;
    Layout = "~/Views/Shared/_User.cshtml";
}

<div class="container py-5">
    <h2 class="my-5">Shopping Cart</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Your cart is empty.</div>
    }
    else
    {
        <table class="table table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Image</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var lineTotal = item.Product.ProductPrice * item.Quantity;
                    totalAmount += lineTotal;

                    <tr>
                        <td>@item.Product.ProductName</td>
                        <td>
                            <img src="~/images/@item.Product.ProductImage" width="80" height="80" />
                        </td>
                        <td>₹@item.Product.ProductPrice</td>
                        <td>@item.Quantity</td>
                        <td>₹@lineTotal</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="text-end">
            <h4>Total: ₹@totalAmount</h4>
            <form asp-controller="User" asp-action="Checkout" method="post">
            <button type="submit" class="btn btn-success mt-3" href="#">Proceed to Checkout</button>
            </form>
        </div>
    }
</div>
